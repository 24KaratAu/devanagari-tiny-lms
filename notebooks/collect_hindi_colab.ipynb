  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sentencepiece as spm\n",
    "\n",
    "TRAIN_TXT = f'{SPLITS_DIR}/train.txt'\n",
    "VOCAB_SIZE_PRIMARY = 8000\n",
    "MPREFIX_8K = f'{TOKENIZER_DIR}/hindi_bpe_8k'\n",
    "\n",
    "train_size_mb = os.path.getsize(TRAIN_TXT) / (1024 * 1024)\n",
    "print(f'Training Primary 8k SentencePiece BPE on {train_size_mb:.1f} MB training text...')\n",
    "\n",
    "spm.SentencePieceTrainer.train(\n",
    "    input=TRAIN_TXT,\n",
    "    model_prefix=MPREFIX_8K,\n",
    "    vocab_size=VOCAB_SIZE_PRIMARY,\n",
    "    model_type='bpe',\n",
    "    character_coverage=0.9995,\n",
    "    num_threads=4,\n",
    "    max_sentence_length=16384,\n",
    "    input_sentence_size=500_000,\n",
    "    shuffle_input_sentence=True,\n",
    "    pad_id=0, unk_id=1, bos_id=2, eos_id=3,\n",
    "    pad_piece='<pad>', unk_piece='<unk>', bos_piece='<bos>', eos_piece='<eos>',\n",
    "    split_by_unicode_script=True,\n",
    "    split_by_whitespace=True,\n",
    "    split_digits=True,\n",
    "    byte_fallback=True,\n",
    ")\n",
    "\n",
    "sp_8k = spm.SentencePieceProcessor()\n",
    "sp_8k.load(f'{MPREFIX_8K}.model')\n",
    "print(f'✅ Primary 8k Model Trained: Actual Vocab Size = {sp_8k.get_piece_size():,}')\n",
    "\n",
