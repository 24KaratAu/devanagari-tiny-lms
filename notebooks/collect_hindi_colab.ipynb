   "source": [
    "--- \n",
    "## Step 5: Intrinsic Tokenizer Benchmark (*Dwivedi & Gopalan, ACL 2026*)\n",
    "\n",
    "Computes Fertility, Characters per Token, Broken Matra Rate, Shannon Entropy, and Rényi Entropy ($\alpha=2$) on held-out validation sentences."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "VAL_TXT = f'{SPLITS_DIR}/val.txt'\n",
    "\n",
    "COMBINING_MARKS = set(chr(c) for c in range(0x0901, 0x0904)) | \\\n",
    "                  set(chr(c) for c in range(0x093E, 0x094E)) | {chr(0x0962), chr(0x0963)}\n",
    "\n",
    "def count_broken_graphemes(tokens):\n",
    "    broken = 0\n",
    "    for tok in tokens:\n",
    "        clean_tok = tok.lstrip(' ')\n",
    "        if clean_tok and clean_tok[0] in COMBINING_MARKS:\n",
    "            broken += 1\n",
    "    return broken\n",
    "\n",
    "val_sentences = []\n",
    "with open(VAL_TXT, 'r', encoding='utf-8') as f:\n",
    "    for line in f:\n",
    "        line = line.strip()\n",
    "        if line and len(line) > 20:\n",
    "            val_sentences.append(line)\n",
    "        if len(val_sentences) >= 5000: break\n",
    "\n",
    "total_words, total_tokens, total_chars, total_broken = 0, 0, 0, 0\n",
    "token_freqs = collections.Counter()\n",
    "\n",
    "for text in val_sentences:\n",
    "    words = text.split()\n",
    "    tokens = sp_8k.encode(text, out_type=str)\n",
    "    token_ids = sp_8k.encode(text, out_type=int)\n",
    "    total_words += len(words)\n",
    "    total_tokens += len(tokens)\n",
    "    total_chars += len(text)\n",
    "    total_broken += count_broken_graphemes(tokens)\n",
    "    token_freqs.update(token_ids)\n",
    "\n",
    "fertility = total_tokens / max(1, total_words)\n",
    "chars_per_tok = total_chars / max(1, total_tokens)\n",
    "broken_rate = (total_broken / max(1, total_tokens)) * 100\n",
    "probs = [c / total_tokens for c in token_freqs.values()]\n",
    "shannon_entropy = -sum(p * math.log2(p) for p in probs if p > 0)\n",
    "renyi_entropy = -math.log2(sum(p**2 for p in probs))\n",
    "\n",
    "print('\\n' + '=' * 75)\n",
    "print('HINDI INTRINSIC TOKENIZER METRICS (SentencePiece BPE 8k)')\n",
    "print('=' * 75)\n",
    "print(f'  Fertility:          {fertility:.2f} tokens / word')\n",
    "print(f'  Characters / Token: {chars_per_tok:.2f}')\n",
    "print(f'  Broken Matra Rate:  {broken_rate:.3f}%')\n",
    "print(f'  Shannon Entropy:    {shannon_entropy:.2f} bits')\n",
    "print(f'  Rényi Entropy:      {renyi_entropy:.2f} bits')\n",
    "print(f'  Unknown Token Rate: 0.00% (byte_fallback=True)')\n",
    "print('=' * 75)"
   ]
  },
